<div id="versionContainer" style="display: none;">
    <div id="versionContent">
        <div id="versionMainContent">
            <div id="versionColumn">
                <img id="versionImageSeal" src="assets/images/SealCircle.ico" draggable="false" />
                <span id="versionHeader">
                    <span data-lang='version.header'></span>
                </span>
                <span id="versionDescription">
                    <span data-lang='version.desc'></span>
                </span>
                <button id="versionClose">
                    <div id="versionCloseContent">
                        <span data-lang='version.close'></span>
                        <svg id="welcomeSVG" viewBox="0 0 24.87 13.97">
                            <defs>
                                <style>.arrowLine{fill:none;stroke:#FFF;stroke-width:2px;transition: 0.25s ease;}</style>
                            </defs>
                            <polyline class="arrowLine" points="0.71 13.26 12.56 1.41 24.16 13.02"/>
                        </svg>
                    </div>
                </button>
            </div>
            <span id="versionReleaseNotes"></span>
        </div>
    </div>
    <script src="./assets/js/scripts/version.js"></script>
</div>