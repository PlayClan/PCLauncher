<div id="languageContainer" style="display: none;">
    <div id="languageContent">
        <img id="languageImageSeal" src="assets/images/SealCircle.ico" draggable="false" />
        <span id="languageHeader">
            <span data-lang='language.header'></span>
        </span>
        <span id="languageDescription">
            <span data-lang='language.desc'></span>
        </span>
        <br>
        <button id="languageButtonHU" class="shopButton">
            <div id="languageButtonHUContent">
                Magyar (HU)
            </div>
        </button>
        <button id="languageButtonEN" class="shopButton">
            <div id="languageButtonENContent">
                English (US)
            </div>
        </button>
        <button id="languageNext">
            <div id="languageNextContent">
                <span data-lang='language.next'></span>
                <svg id="welcomeSVG" viewBox="0 0 24.87 13.97">
                    <defs>
                        <style>.arrowLine{fill:none;stroke:#FFF;stroke-width:2px;transition: 0.25s ease;}</style>
                    </defs>
                    <polyline class="arrowLine" points="0.71 13.26 12.56 1.41 24.16 13.02"/>
                </svg>
            </div>
        </button>
    </div>
    <script src="./assets/js/scripts/language.js"></script>
</div>